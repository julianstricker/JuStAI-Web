---
// Privacy-friendly analytics (self-hosted Plausible, no cookies). Only in the production build.
import { analyticsScript } from '../../site.config.mjs';
const enabled = import.meta.env.PROD && analyticsScript;
---
{enabled && <script async src={analyticsScript}></script>}
{enabled && <script is:inline>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>}
