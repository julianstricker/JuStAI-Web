---
import Default from '@astrojs/starlight/components/Head.astro';
import Analytics from './Analytics.astro';
import { site } from '../../site.config.mjs';
const lang = Astro.locals.starlightRoute.locale === 'de' ? 'de' : 'en';
const ogImage = `${site}${import.meta.env.BASE_URL.replace(/\/$/, '')}/og/og.${lang}.png`;
---
<Default {...Astro.props}><slot /></Default>
<link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`.replace('//','/')} type="image/svg+xml" />
<Analytics />
<meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
<meta name="twitter:image" content={ogImage} />
