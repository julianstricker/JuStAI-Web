      <g class="wing wr"><ellipse cx="166" cy="96" rx="30" ry="12" transform="rotate(28 166 96)" fill="#e9e4ff"/><ellipse cx="160" cy="112" rx="22" ry="8" transform="rotate(12 160 112)" fill="#cfc6ff"/></g>
      <g fill={`url(#${id}p)`} stroke="#ff7aa8" stroke-width="3">
        <circle cx="68" cy="96" r="34"/><circle cx="132" cy="96" r="34"/><circle cx="100" cy="72" r="32"/>
        <circle cx="76" cy="124" r="30"/><circle cx="124" cy="124" r="30"/><circle cx="100" cy="128" r="32"/>
      </g>
      <g fill={`url(#${id}p)`}><circle cx="68" cy="96" r="32"/><circle cx="132" cy="96" r="32"/><circle cx="100" cy="72" r="30"/><circle cx="76" cy="124" r="28"/><circle cx="124" cy="124" r="28"/><circle cx="100" cy="128" r="30"/></g>
      <g fill="none" stroke="#e0558a" stroke-width="3.5" stroke-linecap="round" opacity=".5">
        <path d="M100 44 q-8 18 0 34"/><path d="M60 72 q12 6 14 20"/><path d="M140 72 q-12 6 -14 20"/><path d="M50 108 q10 -2 16 6"/><path d="M150 108 q-10 -2 -16 6"/>
      </g>
      <g class="eyes"><ellipse cx="82" cy="108" rx="8" ry="11" fill="#2a1840"/><ellipse cx="118" cy="108" rx="8" ry="11" fill="#2a1840"/>
        <circle cx="85" cy="104" r="3" fill="#fff"/><circle cx="121" cy="104" r="3" fill="#fff"/></g>
      <ellipse cx="64" cy="124" rx="8" ry="5" fill="#ff5c93" opacity=".5"/><ellipse cx="136" cy="124" rx="8" ry="5" fill="#ff5c93" opacity=".5"/>
      <path d="M90 126 q10 11 20 0" fill="none" stroke="#2a1840" stroke-width="4.5" stroke-linecap="round"/>
      <g class="waves" stroke="#3ee8b5" stroke-width="4" stroke-linecap="round"><path d="M100 28 v-10"/><path d="M80 34 l-7 -8"/><path d="M120 34 l7 -8"/></g>
    </g>
  )}

  {variant === 'camera' && (
    <g class="bob">
      <path d="M100 150 L70 184 M100 150 L130 184 M100 150 L100 184" stroke="#c9bfff" stroke-width="5" stroke-linecap="round"/>
      <rect x="72" y="42" width="56" height="26" rx="10" fill="#4a3bd6"/>
      <rect x="28" y="56" width="144" height="94" rx="28" fill={`url(#${id}v)`}/>
      <circle cx="148" cy="78" r="7" fill="#ffb86b"/><circle class="pulse" cx="52" cy="78" r="5" fill="#ff5c7a"/>
      <circle cx="100" cy="106" r="40" fill="#e9e4ff"/>
      <circle cx="100" cy="106" r="34" fill="#12112b"/>
      <g class="eyes"><circle cx="100" cy="106" r="22" fill="#3ee8b5"/><circle cx="100" cy="106" r="11" fill="#12112b"/>
        <circle cx="107" cy="99" r="5" fill="#fff"/><circle cx="94" cy="113" r="2.4" fill="#fff" opacity=".8"/></g>
      <ellipse cx="46" cy="124" rx="8" ry="5" fill="#ff7aa8" opacity=".6"/><ellipse cx="154" cy="124" rx="8" ry="5" fill="#ff7aa8" opacity=".6"/>
      <path d="M92 140 q8 8 16 0" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".9"/>
    </g>
  )}

  {variant === 'dome' && (
    <g>
      <ellipse cx="100" cy="176" rx="44" ry="10" fill="#e9e4ff"/><rect x="84" y="148" width="32" height="28" rx="10" fill="#cfc6ff"/>
      <g class="pan">
        <circle cx="100" cy="98" r="58" fill="#f4f1ff"/><circle cx="100" cy="98" r="58" fill="none" stroke="#cfc6ff" stroke-width="4"/>
        <circle cx="100" cy="98" r="44" fill="#12112b"/>
        <g class="eyes"><circle cx="100" cy="92" r="23" fill="#3ee8b5"/><circle cx="100" cy="92" r="12" fill="#12112b"/><circle cx="107" cy="85" r="5" fill="#fff"/></g>
        <ellipse cx="68" cy="112" rx="8" ry="5" fill="#ff7aa8" opacity=".55"/><ellipse cx="132" cy="112" rx="8" ry="5" fill="#ff7aa8" opacity=".55"/>
        <path d="M91 124 q9 8 18 0" fill="none" stroke="#3ee8b5" stroke-width="4" stroke-linecap="round"/>
        <circle class="pulse" cx="100" cy="50" r="4" fill="#ffb86b"/>
      </g>
    </g>
  )}

  {variant === 'drone' && (
    <g class="bob">
      <g stroke="#c9bfff" stroke-width="5" stroke-linecap="round"><path d="M70 100 L38 74 M130 100 L162 74"/><path d="M76 140 L66 160 M124 140 L134 160 M60 160 h14 M126 160 h14"/></g>
      <g class="rotor"><ellipse cx="38" cy="70" rx="26" ry="5" fill="#3ee8b5" opacity=".75"/></g>
      <g class="rotor r2"><ellipse cx="162" cy="70" rx="26" ry="5" fill="#3ee8b5" opacity=".75"/></g>
      <rect x="58" y="78" width="84" height="66" rx="26" fill={`url(#${id}v)`}/>
      <circle cx="100" cy="108" r="26" fill="#12112b"/>
      <g class="eyes"><circle cx="100" cy="108" r="16" fill="#3ee8b5"/><circle cx="100" cy="108" r="8" fill="#12112b"/><circle cx="104" cy="103" r="3.4" fill="#fff"/></g>
      <ellipse cx="68" cy="126" rx="6" ry="4" fill="#ff7aa8" opacity=".6"/><ellipse cx="132" cy="126" rx="6" ry="4" fill="#ff7aa8" opacity=".6"/>
      <circle class="pulse" cx="100" cy="86" r="3.5" fill="#ffb86b"/>
    </g>
  )}

  {variant === 'retro' && (
    <g class="bob">
      <rect x="58" y="44" width="34" height="20" rx="6" fill="#6a4cff"/><circle cx="144" cy="52" r="9" fill="#ff7aa8"/>
      <rect x="26" y="58" width="148" height="96" rx="22" fill={`url(#${id}p)`}/>
      <path d="M26 80 q0 -22 22 -22 h104 q22 0 22 22 z" fill="#6a4cff"/>
      <rect x="14" y="76" width="14" height="26" rx="6" fill="#8b6cff"/><rect x="172" y="76" width="14" height="26" rx="6" fill="#8b6cff"/>
      <circle cx="100" cy="108" r="36" fill="#ffe7b8"/><circle cx="100" cy="108" r="30" fill="#2a1840"/>
      <g class="eyes"><circle cx="100" cy="108" r="19" fill="#3ee8b5"/><circle cx="100" cy="108" r="9.5" fill="#12112b"/><circle cx="105" cy="102" r="4" fill="#fff"/></g>
      <ellipse cx="46" cy="130" rx="8" ry="5" fill="#ff5c93" opacity=".5"/><ellipse cx="154" cy="130" rx="8" ry="5" fill="#ff5c93" opacity=".5"/>
      <path d="M92 146 q8 7 16 0" fill="none" stroke="#2a1840" stroke-width="4" stroke-linecap="round"/>
      <circle cx="40" cy="70" r="4" fill="#ffb86b"/>
    </g>
  )}

  {variant === 'eye' && (
    <g class="bob">
      <circle cx="100" cy="100" r="86" fill={`url(#${id}g)`}/>
      <g class="slow" stroke="#ffb86b" stroke-width="5" stroke-linecap="round"><line x1="100" y1="12" x2="100" y2="22" transform="rotate(0 100 100)"/><line x1="100" y1="12" x2="100" y2="18" transform="rotate(30 100 100)"/><line x1="100" y1="12" x2="100" y2="22" transform="rotate(60 100 100)"/><line x1="100" y1="12" x2="100" y2="18" transform="rotate(90 100 100)"/><line x1="100" y1="12" x2="100" y2="22" transform="rotate(120 100 100)"/><line x1="100" y1="12" x2="100" y2="18" transform="rotate(150 100 100)"/><line x1="100" y1="12" x2="100" y2="22" transform="rotate(180 100 100)"/><line x1="100" y1="12" x2="100" y2="18" transform="rotate(210 100 100)"/><line x1="100" y1="12" x2="100" y2="22" transform="rotate(240 100 100)"/><line x1="100" y1="12" x2="100" y2="18" transform="rotate(270 100 100)"/><line x1="100" y1="12" x2="100" y2="22" transform="rotate(300 100 100)"/><line x1="100" y1="12" x2="100" y2="18" transform="rotate(330 100 100)"/></g>
      <g class="eyes">
        <path d="M22 100 Q100 24 178 100 Q100 176 22 100 Z" fill="#f4f1ff"/>
        <path d="M22 100 Q100 24 178 100" fill="none" stroke="#7c5cff" stroke-width="6" stroke-linecap="round"/>
        <circle cx="100" cy="100" r="36" fill="#3ee8b5"/><circle cx="100" cy="100" r="36" fill="none" stroke="#12a583" stroke-width="4"/>
        <circle cx="100" cy="100" r="17" fill="#12112b"/><circle cx="110" cy="89" r="7" fill="#fff"/><circle cx="91" cy="110" r="3" fill="#fff" opacity=".8"/>
      </g>
      <circle cx="40" cy="48" r="3.5" fill="#3ee8b5"/><circle cx="164" cy="156" r="3" fill="#ffb86b"/>
    </g>
  )}

  {variant === 'orb' && (
    <g class="bob">
      <circle cx="100" cy="100" r="82" fill={`url(#${id}g)`}/>
      <g transform="rotate(-18 100 100)"><path d="M16 100 A84 22 0 0 1 184 100" fill="none" stroke="#c9bfff" stroke-width="5" opacity=".5"/></g>
      <circle cx="100" cy="100" r="56" fill={`url(#${id}v)`}/>
      <ellipse cx="80" cy="70" rx="20" ry="11" transform="rotate(-30 80 70)" fill="#fff" opacity=".28"/>
      <g class="eyes"><ellipse cx="100" cy="104" rx="26" ry="22" fill="#12112b"/><circle cx="100" cy="104" r="17" fill="#3ee8b5"/><circle cx="100" cy="104" r="8" fill="#12112b"/><circle cx="105" cy="98" r="3.6" fill="#fff"/></g>
      <g transform="rotate(-18 100 100)"><path d="M16 100 A84 22 0 0 0 184 100" fill="none" stroke="#c9bfff" stroke-width="5"/><circle class="pulse" cx="184" cy="100" r="7" fill="#ffb86b"/></g>
      <circle cx="30" cy="56" r="3" fill="#3ee8b5"/><circle cx="170" cy="150" r="3.5" fill="#fff" opacity=".7"/>
    </g>
  )}

  {variant === 'ring' && (
    <g class="bob">
      <circle class="pulse" cx="100" cy="100" r="74" fill="none" stroke="#3ee8b5" stroke-width="3" opacity=".5"/>
      <circle class="pulse p2" cx="100" cy="100" r="58" fill="none" stroke="#3ee8b5" stroke-width="3" opacity=".7"/>
      <g class="slow"><circle cx="100" cy="100" r="84" fill="none" stroke="#c9bfff" stroke-width="4" stroke-linecap="round" stroke-dasharray="26 22" opacity=".7"/></g>
      <circle cx="100" cy="100" r="44" fill="none" stroke="#7c5cff" stroke-width="14"/>
      <circle cx="100" cy="100" r="44" fill="none" stroke="#9b82ff" stroke-width="4" stroke-dasharray="70 210" stroke-linecap="round"/>
      <circle cx="100" cy="100" r="36" fill="#12112b"/>
      <g class="eyes"><circle cx="100" cy="94" r="14" fill="#3ee8b5"/><circle cx="100" cy="94" r="6.5" fill="#12112b"/><circle cx="104" cy="89" r="3" fill="#fff"/></g>
      <path d="M91 116 q9 7 18 0" fill="none" stroke="#3ee8b5" stroke-width="3.5" stroke-linecap="round"/>
    </g>
  )}

  {variant === 'halo' && (
    <g class="bob">
      <g class="wing wl"><ellipse cx="34" cy="104" rx="30" ry="12" transform="rotate(-28 34 104)" fill="#e9e4ff"/><ellipse cx="40" cy="120" rx="22" ry="8" transform="rotate(-12 40 120)" fill="#cfc6ff"/></g>
      <g class="wing wr"><ellipse cx="166" cy="104" rx="30" ry="12" transform="rotate(28 166 104)" fill="#e9e4ff"/><ellipse cx="160" cy="120" rx="22" ry="8" transform="rotate(12 160 120)" fill="#cfc6ff"/></g>
      <ellipse class="pulse" cx="100" cy="36" rx="32" ry="9" fill="none" stroke="#ffb86b" stroke-width="6"/>
      <circle cx="100" cy="106" r="52" fill="#f4f1ff"/><circle cx="100" cy="106" r="52" fill="none" stroke="#cfc6ff" stroke-width="4"/>
      <circle cx="100" cy="106" r="39" fill="#12112b"/>
      <g class="eyes"><circle cx="100" cy="100" r="20" fill="#3ee8b5"/><circle cx="100" cy="100" r="10" fill="#12112b"/><circle cx="106" cy="94" r="4.4" fill="#fff"/></g>
      <ellipse cx="72" cy="120" rx="7" ry="4.5" fill="#ff7aa8" opacity=".55"/><ellipse cx="128" cy="120" rx="7" ry="4.5" fill="#ff7aa8" opacity=".55"/>
      <path d="M92 130 q8 7 16 0" fill="none" stroke="#3ee8b5" stroke-width="3.8" stroke-linecap="round"/>
    </g>
  )}

  {mood === 'listening' && (
    <g class="listen" fill="none" stroke="#3ee8b5" stroke-width="4" stroke-linecap="round"><path d="M178 60 q10 14 0 28"/><path d="M188 52 q16 22 0 44" opacity=".6"/></g>
  )}
</svg>
<style>
  .mascot { overflow: visible; display: block; }
  .bob { animation: bob 4s ease-in-out infinite; transform-origin: 50% 90%; }
  .eyes { animation: blink 5s infinite; transform-box: fill-box; transform-origin: center; }
  .pulse { animation: pulse 2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .wing { animation: flap .5s ease-in-out infinite alternate; transform-box: fill-box; }
  .wl { transform-origin: 100% 60%; } .wr { transform-origin: 0% 60%; } .wr { animation-name: flapr; }
  .pan { animation: pan 6s ease-in-out infinite; transform-box: fill-box; transform-origin: 50% 80%; }
  .rotor { animation: spin .12s linear infinite alternate; transform-box: fill-box; transform-origin: center; } .r2 { animation-delay: -.06s; }
  .slow { animation: turn 24s linear infinite; transform-box: fill-box; transform-origin: center; }
  .p2 { animation-delay: -1s; }
  .waves, .listen { animation: fade 2.2s ease-in-out infinite; }
  @keyframes bob { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-5px) } }
  @keyframes blink { 0%,94%,100% { transform: scaleY(1) } 97% { transform: scaleY(.1) } }
  @keyframes pulse { 0%,100% { transform: scale(1); opacity: 1 } 50% { transform: scale(1.5); opacity: .5 } }
  @keyframes flap { from { transform: rotate(8deg) } to { transform: rotate(-14deg) } }
  @keyframes flapr { from { transform: rotate(-8deg) } to { transform: rotate(14deg) } }
  @keyframes pan { 0%,100% { transform: rotate(-7deg) } 50% { transform: rotate(7deg) } }
  @keyframes spin { from { transform: scaleX(1) } to { transform: scaleX(.55) } }
  @keyframes turn { to { transform: rotate(360deg) } }
  @keyframes fade { 0%,100% { opacity: .25 } 50% { opacity: 1 } }
  @media (prefers-reduced-motion: reduce) { .bob, .eyes, .pulse, .waves, .listen, .wing, .pan, .rotor, .slow { animation: none } }
</style>
