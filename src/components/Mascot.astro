---
// The JuStAI mascot. variant: "robot" (Juno), "house" (Hausi), "owl" (Uhu).
interface Props { variant?: 'robot' | 'house' | 'owl'; size?: number; mood?: 'happy' | 'listening'; class?: string }
const { variant = 'robot', size = 220, mood = 'happy', class: cls = '' } = Astro.props;
const id = `m${Math.random().toString(36).slice(2, 7)}`;
---
<svg class={`mascot ${variant} ${mood} ${cls}`} width={size} height={size} viewBox="0 0 200 200" role="img" aria-label="JuStAI mascot" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={`${id}v`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9b82ff"/><stop offset="1" stop-color="#5b3df5"/></linearGradient>
    <linearGradient id={`${id}p`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffc98a"/><stop offset="1" stop-color="#ff7aa8"/></linearGradient>
    <linearGradient id={`${id}o`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7f8cff"/><stop offset="1" stop-color="#4a3bd6"/></linearGradient>
    <radialGradient id={`${id}g`}><stop offset="0" stop-color="#3ee8b5" stop-opacity=".55"/><stop offset="1" stop-color="#3ee8b5" stop-opacity="0"/></radialGradient>
  </defs>
  <ellipse cx="100" cy="188" rx="52" ry="7" fill="#000" opacity=".18"/>

  {variant === 'robot' && (
    <g class="bob">
      <line x1="100" y1="52" x2="100" y2="30" stroke="#c9bfff" stroke-width="5" stroke-linecap="round"/>
      <circle class="pulse" cx="100" cy="26" r="16" fill={`url(#${id}g)`}/>
      <circle cx="100" cy="26" r="7" fill="#ffb86b"/>
      <rect x="64" y="148" width="72" height="36" rx="18" fill={`url(#${id}v)`}/>
      <path d="M92 166 l8 -7 l8 7 v9 a3 3 0 0 1 -3 3 h-10 a3 3 0 0 1 -3 -3z" fill="#fff" opacity=".92"/>
      <rect x="26" y="88" width="14" height="30" rx="7" fill="#3ee8b5"/>
      <rect x="160" y="88" width="14" height="30" rx="7" fill="#3ee8b5"/>
      <rect x="36" y="52" width="128" height="104" rx="46" fill={`url(#${id}v)`}/>
      <rect x="50" y="68" width="100" height="72" rx="34" fill="#12112b"/>
      <g class="eyes"><ellipse cx="80" cy="98" rx="10" ry="13" fill="#3ee8b5"/><ellipse cx="120" cy="98" rx="10" ry="13" fill="#3ee8b5"/>
        <circle cx="83" cy="93" r="3.4" fill="#fff"/><circle cx="123" cy="93" r="3.4" fill="#fff"/></g>
      <ellipse cx="64" cy="118" rx="8" ry="5" fill="#ff7aa8" opacity=".55"/><ellipse cx="136" cy="118" rx="8" ry="5" fill="#ff7aa8" opacity=".55"/>
      <path d="M90 118 q10 10 20 0" fill="none" stroke="#3ee8b5" stroke-width="4.5" stroke-linecap="round"/>
    </g>
  )}

  {variant === 'house' && (
    <g class="bob">
      <rect x="128" y="22" width="16" height="30" rx="4" fill="#ff7aa8"/>
      <g class="waves" fill="none" stroke="#3ee8b5" stroke-width="4" stroke-linecap="round"><path d="M150 18 q8 -6 16 0"/><path d="M148 8 q14 -12 30 0" opacity=".6"/></g>
      <path d="M100 24 L162 74 Q172 82 172 96 L172 150 Q172 182 140 182 L60 182 Q28 182 28 150 L28 96 Q28 82 38 74 Z" fill={`url(#${id}p)`} stroke="#ffb86b" stroke-width="6" stroke-linejoin="round"/>
      <path d="M100 24 L162 74 Q172 82 172 96 L28 96 Q28 82 38 74 Z" fill="#6a4cff" opacity=".9" stroke="#6a4cff" stroke-width="6" stroke-linejoin="round"/>
      <g class="eyes"><ellipse cx="76" cy="122" rx="9" ry="12" fill="#2a1840"/><ellipse cx="124" cy="122" rx="9" ry="12" fill="#2a1840"/>
        <circle cx="79" cy="117" r="3.2" fill="#fff"/><circle cx="127" cy="117" r="3.2" fill="#fff"/></g>
      <ellipse cx="58" cy="144" rx="9" ry="5.5" fill="#ff5c93" opacity=".5"/><ellipse cx="142" cy="144" rx="9" ry="5.5" fill="#ff5c93" opacity=".5"/>
      <path d="M90 142 q10 11 20 0" fill="none" stroke="#2a1840" stroke-width="4.5" stroke-linecap="round"/>
      <circle cx="100" cy="68" r="9" fill="#ffe7b8"/><circle cx="100" cy="68" r="4" fill="#ffb86b"/>
    </g>
  )}

  {variant === 'owl' && (
    <g class="bob">
      <path d="M52 62 L44 28 L82 50 Z M148 62 L156 28 L118 50 Z" fill="#4a3bd6" stroke="#4a3bd6" stroke-width="6" stroke-linejoin="round"/>
      <ellipse cx="100" cy="116" rx="68" ry="70" fill={`url(#${id}o)`}/>
      <ellipse cx="100" cy="136" rx="40" ry="38" fill="#cfd4ff" opacity=".95"/>
      <g fill="#7f8cff" opacity=".7"><path d="M84 128 q6 6 12 0"/><path d="M104 128 q6 6 12 0"/><path d="M94 144 q6 6 12 0"/></g>
      <path d="M32 112 q-14 30 12 56 q6 -26 -12 -56z" fill="#3a2fb8"/><path d="M168 112 q14 30 -12 56 q-6 -26 12 -56z" fill="#3a2fb8"/>
      <circle cx="72" cy="96" r="26" fill="#f4f1ff"/><circle cx="128" cy="96" r="26" fill="#f4f1ff"/>
      <g class="eyes"><circle cx="74" cy="98" r="14" fill="#12112b"/><circle cx="126" cy="98" r="14" fill="#12112b"/>
        <circle cx="79" cy="92" r="4.5" fill="#fff"/><circle cx="131" cy="92" r="4.5" fill="#fff"/><circle cx="72" cy="104" r="2.4" fill="#3ee8b5"/><circle cx="124" cy="104" r="2.4" fill="#3ee8b5"/></g>
      <path d="M92 112 L108 112 L100 128 Z" fill="#ffb86b" stroke="#ffb86b" stroke-width="4" stroke-linejoin="round"/>
      <path d="M78 186 h14 M108 186 h14" stroke="#ffb86b" stroke-width="6" stroke-linecap="round"/>
    </g>
  )}

  {mood === 'listening' && (
    <g class="listen" fill="none" stroke="#3ee8b5" stroke-width="4" stroke-linecap="round"><path d="M178 60 q10 14 0 28"/><path d="M188 52 q16 22 0 44" opacity=".6"/></g>
  )}
</svg>
<style>
  .mascot { overflow: visible; display: block; }
  .bob { animation: bob 4s ease-in-out infinite; transform-origin: 50% 90%; }
  .eyes { animation: blink 5s infinite; transform-box: fill-box; transform-origin: center; }
  .pulse { animation: pulse 2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .waves, .listen { animation: fade 2.2s ease-in-out infinite; }
  @keyframes bob { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-5px) } }
  @keyframes blink { 0%,94%,100% { transform: scaleY(1) } 97% { transform: scaleY(.1) } }
  @keyframes pulse { 0%,100% { transform: scale(1); opacity: 1 } 50% { transform: scale(1.5); opacity: .5 } }
  @keyframes fade { 0%,100% { opacity: .25 } 50% { opacity: 1 } }
  @media (prefers-reduced-motion: reduce) { .bob, .eyes, .pulse, .waves, .listen { animation: none } }
</style>
