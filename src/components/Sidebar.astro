---
// The docs search lives at the top of the sidebar so the header stays identical to the landing page.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import { repo } from '../../site.config.mjs';
import { copy } from '../i18n/landing';

const lang = Astro.locals.starlightRoute.locale === 'de' ? 'de' : 'en';
const t = copy[lang].nav;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const pre = lang === 'de' ? `${b}/de` : b;
const home = `${pre}/`;
---
<div class="sidebar-search"><Search /></div>
<nav class="site-links" aria-label="JuStAI">
  <a href={home}>JuStAI</a><a href={`${home}#examples`}>{t.examples}</a><a href={`${home}#features`}>{t.features}</a><a href={`${home}#install`}>{t.install}</a><a href={`https://github.com/${repo}`} rel="noopener">GitHub</a>
</nav>
<Default {...Astro.props}><slot /></Default>
<style is:global>
  .sidebar-search { position: fixed; z-index: 3; top: var(--sl-nav-height); left: 0; right: 0; padding: .75rem 1rem; background: var(--sl-color-bg-sidebar); border-bottom: 1px solid var(--sl-color-hairline-shade, var(--sl-color-hairline)); }
  .sidebar-search site-search, .sidebar-search button { width: 100%; }
  @media (min-width: 50rem) { .sidebar-search { right: auto; width: var(--sl-sidebar-width); } }
  .sidebar-content { padding-top: 4.5rem !important; }
  /* site links (landing page sections) are only needed in the mobile drawer, the header shows them on desktop */
  .site-links { display: none; }
  @media (max-width: 49.99rem) {
    .site-links { display: flex; flex-wrap: wrap; gap: .4rem .9rem; padding: 0 0 1rem; margin-bottom: 1rem; border-bottom: 1px solid var(--sl-color-hairline); }
    .site-links a { font-weight: 600; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); text-decoration: none; }
  }
  /* the sidebar drawer is hidden on mobile until opened */
  @media (max-width: 49.99rem) { body:not(:has(#starlight__sidebar:popover-open)) .sidebar-search { display: none; } }
</style>
