---
// Top navigation shared by the landing page and the Starlight docs (via Header.astro).
import Mascot from './Mascot.astro';
import { repo } from '../../site.config.mjs';
import { copy } from '../i18n/landing';

interface Props { lang?: 'en' | 'de'; docs?: boolean; altHref?: string }
const { lang = 'en', docs = false, altHref } = Astro.props;
const t = copy[lang].nav;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const pre = lang === 'de' ? `${b}/de` : b;
// the same page in the other language (landing or docs)
const path = Astro.url.pathname;
const other = altHref ?? (lang === 'de' ? path.replace(`${b}/de`, b || '/') : path.replace(b, `${b}/de`));
const home = lang === 'de' ? `${b}/de/` : `${b}/`;
---
<header class={docs ? 'nav docs' : 'nav'}>
  <a class="brand" href={home}><Mascot variant="ring" size={34} class="mini" /><span>JuStAI</span></a>
  <nav>
    <button id="burger" class="pill burger" aria-label="Menu" aria-expanded="false" aria-controls="navlinks">☰</button>
    <div id="navlinks" class="links">
      <a href={`${home}#examples`}>{t.examples}</a><a href={`${home}#features`}>{t.features}</a><a href={`${home}#install`}>{t.install}</a><a href={`${pre}/docs/`}>{t.docs}</a>
      <a href={`https://github.com/${repo}`} rel="noopener">GitHub</a>
    </div>
    <a class="pill" href={other}>{lang === 'de' ? 'EN' : 'DE'}</a>
    <button id="theme" class="pill" aria-label="Toggle theme">🌓</button>
  </nav>
</header>
<script is:inline>
  (function () {
    var burger = document.getElementById('burger'), links = document.getElementById('navlinks');
    if (burger && links) {
      burger.addEventListener('click', function () {
        var open = links.classList.toggle('open');
        burger.setAttribute('aria-expanded', String(open));
      });
      links.addEventListener('click', function (e) { if (e.target.closest('a')) links.classList.remove('open'); });
    }
    var btn = document.getElementById('theme');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var n = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = n;
      try { localStorage.setItem('starlight-theme', n); } catch (e) {}
    });
  })();
</script>
<style is:global>
  :root { --bg:#0e0d24; --bg2:#17153a; --card:#1c1a44; --fg:#f4f1ff; --mut:#b4b0d6; --acc:#7c5cff; --mint:#3ee8b5; --peach:#ffb86b; --line:#ffffff1a; --ico:#2a2670; }
  :root[data-theme='light'] { --bg:#faf8ff; --bg2:#efeaff; --card:#fff; --fg:#17143a; --mut:#5d5890; --acc:#5b3df5; --mint:#0c9e78; --peach:#e67e22; --line:#17143a1a; --ico:#e8e1ff; }
  .nav { position:sticky; top:0; z-index:10; display:flex; justify-content:space-between; align-items:center; gap:12px; padding:10px 20px; backdrop-filter: blur(14px); background: color-mix(in srgb, var(--bg) 78%, transparent); border-bottom:1px solid var(--line); }
  .brand { display:flex; align-items:center; gap:8px; font-weight:800; font-size:1.2rem; color:var(--fg)!important; text-decoration:none; } .brand b { color:var(--mint); }
  .nav nav { display:flex; align-items:center; gap:16px; flex-wrap:wrap; justify-content:flex-end; } .nav nav a { color:var(--mut); text-decoration:none; font-weight:600; font-size:.95rem; } .nav nav a:hover { color:var(--fg); }
  .pill { border:1px solid var(--line); background:transparent; color:var(--fg)!important; border-radius:99px; padding:4px 12px; cursor:pointer; font:inherit; font-size:.85rem; }
  .nav nav a:not(.pill) { }
  .nav .links { display:flex; align-items:center; gap:16px; } .nav .burger { display:none; }
  @media (max-width:860px) {
    .nav nav { flex-wrap:nowrap; gap:8px; } .nav .burger { display:inline-block; }
    .nav .links { display:none; position:absolute; top:100%; left:0; right:0; flex-direction:column; align-items:stretch; gap:0; padding:8px 20px 14px; background:var(--bg); border-bottom:1px solid var(--line); }
    .nav .links.open { display:flex; } .nav .links a { padding:12px 0; font-size:1.05rem; border-top:1px solid var(--line); } .nav .links a:first-child { border-top:0; }
  }
  /* docs, phone width: Starlight's own round sidebar button sits at the right edge, the site links live in the sidebar */
  @media (max-width:49.99rem) { .nav.docs .burger, .nav.docs .links { display:none; } .nav.docs nav { margin-inline-end:3rem; } }
  .nav nav a { white-space:nowrap; }
  .header { padding:0 !important; --sl-nav-height: 56px; }
  .header .nav { position:static; width:100%; height:100%; }
</style>
