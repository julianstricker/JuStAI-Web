---
import Mascot from '../components/Mascot.astro';
const items = [
  { v: 'robot', name: 'Juno', text: 'Friendly robot with an antenna. Techy, easy to animate, fits an AI assistant.' },
  { v: 'house', name: 'Hausi', text: 'A little house spirit. Warm and cuddly, says "this is your home".' },
  { v: 'brain', name: 'Brainy', text: 'A little flying brain with wings. Playful, instantly says "AI", very memorable.' },
  { v: 'camera', name: 'Cami', text: 'A camera with a big lens eye. Points at what JuStAI5 does: seeing, and watching over the home.' },
  { v: 'dome', name: 'Domo', text: 'A pan/tilt dome camera like the Tapo C200. It turns its head and follows you.' },
  { v: 'drone', name: 'Flio', text: 'A flying camera drone with spinning rotors. Playful, and it looks everywhere in the house.' },
  { v: 'retro', name: 'Retro', text: 'A retro photo camera in warm peach. Friendly, nostalgic, less "surveillance".' },
  { v: 'halo', name: 'Domo Halo', text: 'Domo with a halo and little wings: a friendly guardian watching over the home.' },
  { v: 'eye', name: 'Oki', text: 'Just one big eye with sun rays. Stylised, bold, instantly a logo.' },
  { v: 'orb', name: 'Orbi', text: 'A floating glass orb with one eye and an orbiting ring. A calm "higher being".' },
  { v: 'ring', name: 'Echo', text: 'An abstract voice ring with a tiny eye. Modern, assistant-like, great as a logo.' },
  { v: 'owl', name: 'Uhu', text: 'An owl that listens. Classic mascot, great recognition.' },
];
---
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mascot candidates</title><meta name="robots" content="noindex">
<style>
  body { margin:0; font-family: system-ui, sans-serif; background:#12112b; color:#f4f1ff; padding:48px 16px; }
  h1 { text-align:center; } .row { display:flex; flex-wrap:wrap; gap:24px; justify-content:center; }
  .card { background:#1c1a40; border-radius:24px; padding:28px; width:260px; text-align:center; }
  .card :global(svg) { margin:0 auto 12px; } h2 { margin:8px 0 4px; } p { opacity:.75; font-size:.95rem; }
</style></head><body>
<h1>Pick a mascot</h1>
<div class="row">
  {items.map((i) => (<div class="card"><Mascot variant={i.v as any} size={200} /><h2>{i.name}</h2><p>{i.text}</p></div>))}
</div>
</body></html>
