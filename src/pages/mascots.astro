---
import Mascot from '../components/Mascot.astro';
const items = [
  { v: 'robot', name: 'Juno', text: 'Friendly robot with an antenna. Techy, easy to animate, fits an AI assistant.' },
  { v: 'house', name: 'Hausi', text: 'A little house spirit. Warm and cuddly, says "this is your home".' },
  { v: 'owl', name: 'Uhu', text: 'An owl that listens. Classic mascot, great recognition.' },
];
---
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mascot candidates</title>
<style>
  body { margin:0; font-family: system-ui, sans-serif; background:#12112b; color:#f4f1ff; padding:48px 16px; }
  h1 { text-align:center; } .row { display:flex; flex-wrap:wrap; gap:24px; justify-content:center; }
  .card { background:#1c1a40; border-radius:24px; padding:28px; width:260px; text-align:center; }
  .card :global(svg) { margin:0 auto 12px; } h2 { margin:8px 0 4px; } p { opacity:.75; font-size:.95rem; }
</style></head><body>
<h1>Pick a mascot</h1>
<div class="row">
  {items.map((i) => (<div class="card"><Mascot variant={i.v as any} size={200} /><h2>{i.name}</h2><p>{i.text}</p></div>))}
</div>
</body></html>
